# Two non-persistent joint sets. trace/n_trace defines segment lengths and
# gap/n_gap defines the discontinuities between adjacent segments.
odfn.geometry.domain [-6 6 -6 6]
odfn.geometry.minsize 0.08
odfn.geometry.minangle 18
odfn.geometry.square 'rock' [-5 5 -5 5]
odfn.geometry.cut.jset 'discontinuous_set_01' 'rock' n_dip 50 4 n_space 1.50 0.12 n_trace 1.60 0.20 n_gap 0.75 0.10
odfn.geometry.cut.jset 'discontinuous_set_02' 'rock' n_dip 130 4 n_space 1.65 0.12 n_trace 1.35 0.18 n_gap 0.65 0.08
odfn.geometry.mesh.size 'default' 0.28
odfn.geometry.mesh auto
