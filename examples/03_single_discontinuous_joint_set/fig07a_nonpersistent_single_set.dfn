# Fig. 7(a,b): one non-persistent set; constant traces and gaps clarify geometry.
odfn.geometry.domain [-5.2 5.2 -5.2 5.2]
odfn.geometry.minsize 0.04
odfn.geometry.minangle 12
odfn.geometry.iteration 80
odfn.geometry.square 'rock' [-5 5 -5 5]
odfn.geometry.cut.jset 'nonpersistent_set_01' 'rock' dip 35 space 0.75 trace 1.20 gap 0.42 start -4.75 4.75
odfn.geometry.mesh.size 'default' 0.28
odfn.geometry.mesh delaunay


