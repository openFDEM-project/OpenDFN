# Multiple deterministic joints with different positions and orientations.
odfn.geometry.domain [-6 6 -6 6]
odfn.geometry.minsize 0.10
odfn.geometry.minangle 18
odfn.geometry.square 'rock' [-5 5 -5 5]
odfn.geometry.cut.joint 'joint_01' 'rock' [-5 -3 5 -1]
odfn.geometry.cut.joint 'joint_02' 'rock' [-5 0 5 2]
odfn.geometry.cut.joint 'joint_03' 'rock' [-3 -5 -1 5]
odfn.geometry.cut.joint 'joint_04' 'rock' [1 -5 4 5]
odfn.geometry.cut.joint 'joint_05' 'rock' [-5 4 5 3]
odfn.geometry.mesh.size 'default' 0.32
odfn.geometry.mesh auto
